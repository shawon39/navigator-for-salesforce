{
    "name": "Navigator for Salesforce",
    "description": "Open any Salesforce Setup page, object, field, record, app or org in a few keystrokes.",
    "version": "5.0.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup.html",
        "default_title": "Navigator for Salesforce",
        "default_icon": {
            "16": "/images/navigator16.png",
            "32": "/images/navigator32.png",
            "48": "/images/navigator48.png",
            "128": "/images/navigator128.png"
        }
    },
    "icons": {
        "16": "/images/navigator16.png",
        "32": "/images/navigator32.png",
        "48": "/images/navigator48.png",
        "128": "/images/navigator128.png"
    },
    "permissions": ["storage", "cookies"],
    "host_permissions": ["https://*.force.com/*", "https://*.my.salesforce.com/*", "https://*.my.salesforce-setup.com/*"],
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+N",
                "mac": "Alt+N"
            },
            "description": "Open Navigator for Salesforce"
        },
        "navigate_to_setup": {
            "suggested_key": {
                "default": "Alt+S",
                "mac": "Alt+S"
            },
            "description": "Navigate to Salesforce Setup"
        },
        "navigate_to_home": {
            "suggested_key": {
                "default": "Alt+A",
                "mac": "Alt+A"
            },
            "description": "Navigate to Salesforce Home"
        },
        "open_command_palette": {
            "suggested_key": {
                "default": "Alt+K",
                "mac": "Alt+K"
            },
            "description": "Open the command palette"
        }
    },
    "content_scripts": [
        {
            "matches": ["https://*.force.com/*", "https://*.my.salesforce.com/*", "https://*.my.salesforce-setup.com/*"],
            "js": ["src/shared/sfUrl.js", "src/shared/settings.js", "src/shared/orgs.js", "src/content/contentSetup.js", "src/content/headerButton.js", "src/shared/setupPages.js", "src/shared/recents.js", "src/content/commandPalette.data.js", "src/content/commandPalette.js"],
            "css": ["styles/setupStyle.css"],
            "run_at": "document_end"
        }
    ],
    "options_page": "settings.html",
    "background": {
        "service_worker": "src/background/background.js"
    },
    "web_accessible_resources": [
        {
            "resources": ["images/*", "fonts/*"],
            "matches": ["https://*.force.com/*", "https://*.my.salesforce.com/*", "https://*.my.salesforce-setup.com/*"]
        }
    ]
}
